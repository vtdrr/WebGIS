# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/phenikaa_gis
DB_SSL=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Swagger
SWAGGER_ENABLED=true

# Optional: protect POST/PATCH/DELETE /api/* with this key
# Clients send it as header `x-admin-key` or `Authorization: Bearer <key>`
# ADMIN_API_KEY=