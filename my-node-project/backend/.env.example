# Local development values only. Replace secrets and URLs for other environments.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/phenikaa_gis
DB_SSL=false
DB_POOL_MAX=20

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SWAGGER_ENABLED=true

# Set a private value before exposing write endpoints; required in production.
ADMIN_API_KEY=replace-with-a-local-secret

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
