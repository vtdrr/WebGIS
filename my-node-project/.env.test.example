# Copy to .env.test.local (ignored by Git) and replace the placeholder with a
# random local-only password before starting docker-compose.test.yml.
WEBGIS_TEST_POSTGRES_PASSWORD=replace-with-a-random-test-only-password
TEST_DATABASE_URL=postgres://postgres:replace-with-a-random-test-only-password@127.0.0.1:5433/phenikaa_gis_test
DATABASE_URL=postgres://postgres:replace-with-a-random-test-only-password@127.0.0.1:5433/phenikaa_gis_test
E2E_DATABASE_URL=postgres://postgres:replace-with-a-random-test-only-password@127.0.0.1:5433/phenikaa_gis_e2e
DB_SSL=false
NODE_ENV=test
SWAGGER_ENABLED=false
# For Playwright only: export E2E_ADMIN_KEY and ADMIN_API_KEY when launching E2E.
# Keep ADMIN_API_KEY unset while running backend Vitest (admin auth tests expect no configured key).
E2E_ADMIN_KEY=replace-with-a-random-test-only-admin-key
